{
  "info": {
    "name": "SportsShed LG-5 API",
    "description": "Postman requests for the SportsShed assignment",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Add Player",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"playerName\": \"Yashwanth\"\n}"
        },
        "url": "{{baseUrl}}/players/"
      }
    },
    {
      "name": "Get Players",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/players/"
      }
    },
    {
      "name": "Add Kit",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"kitName\": \"Cricket Bat\",\n  \"sport\": \"Cricket\"\n}"
        },
        "url": "{{baseUrl}}/kits/"
      }
    },
    {
      "name": "Search Kits by Sport",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/kits/?sport=Cricket"
      }
    },
    {
      "name": "Get Kits",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/kits/"
      }
    },
    {
      "name": "Add Loan",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"playerId\": 1,\n  \"kitId\": 1\n}"
        },
        "url": "{{baseUrl}}/loans/"
      }
    },
    {
      "name": "Get Loans with Player and Kit Names",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/loans/"
      }
    },
    {
      "name": "Return Loan",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/loans/1/return"
      }
    },
    {
      "name": "Player Returned Loan History",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/players/1/history"
      }
    }
  ]
}